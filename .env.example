# askchimps/dashboard — runtime environment.
# Copy to .env.local for development. .env.local is gitignored.

# Backend API base (server-side calls go here; not exposed to client).
# Local dev: api container binds 127.0.0.1:3000 on the host.
API_BASE_URL=http://127.0.0.1:3000

# Cookie used to carry the access JWT to subsequent requests.
SESSION_COOKIE_NAME=askchimps_session

# Set to "1" in production to require HTTPS for the session cookie.
SESSION_COOKIE_SECURE=0
